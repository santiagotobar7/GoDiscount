<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GoDiscount - Ahorros y ofertas inteligentes</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .tab-content { display: none; }
    .tab-content.active { display: block; }
  </style>
</head>
<body class="bg-amber-50/30 font-sans text-gray-800">

  <!-- Header GoDiscount -->
  <header class="bg-gradient-to-r from-orange-500 via-orange-600 to-amber-500 text-white shadow-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 py-2 flex justify-between items-center">
      <div class="flex items-center space-x-3">
        
        <!-- Logo SVG Integrado con Letras G y D en color Amarillo (#FFD700) -->
        <div class="w-16 h-10 flex items-center justify-center bg-white/10 rounded-xl p-1 backdrop-blur-sm border border-white/20">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 320" class="w-full h-full">
            <defs>
              <filter id="text-shadow" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="1" stdDeviation="1" flood-color="#000000" flood-opacity="0.2"/>
              </filter>
            </defs>
            <g transform="translate(0, 0)">
              <!-- Letra G (Amarillo #FFD700) -->
              <path d="M 180 50 C 100 50, 40 100, 40 160 C 40 220, 100 270, 180 270 C 230 270, 260 240, 260 210 L 170 210 L 170 170 L 300 170 L 300 220 C 275 280, 225 310, 180 310 C 70 310, 0 240, 0 160 C 0 80, 70 10, 180 10 C 235 10, 280 35, 310 75 L 265 110 C 245 80, 220 50, 180 50 Z" fill="#FFD700" stroke="#FF5500" stroke-width="14" stroke-linejoin="round" stroke-linecap="round"/>
              <!-- Letra D (Amarillo #FFD700 para contraste) -->
              <path d="M 285 45 L 360 45 C 445 45, 495 95, 495 160 C 495 225, 445 275, 360 275 L 285 275 Z" fill="#FFD700" stroke="#FF5500" stroke-width="10" stroke-linejoin="round" />
              <!-- Centro D -->
              <path d="M 325 85 L 355 85 C 405 85, 445 115, 445 160 C 445 205, 405 235, 355 235 L 325 235 Z" fill="#FF5500" />
              <!-- Porcentaje % (AZUL OSCURO) -->
              <g fill="#0F172A" stroke="#0F172A" filter="url(#text-shadow)">
                <circle cx="360" cy="125" r="11" stroke-width="6" fill="none" />
                <path d="M 402 115 L 362 205" stroke-width="8" stroke-linecap="round" />
                <circle cx="405" cy="195" r="11" stroke-width="6" fill="none" />
              </g>
            </g>
          </svg>
        </div>

        <div>
          <h1 class="font-extrabold text-2xl tracking-wide uppercase flex items-center gap-1.5 leading-none text-white drop-shadow">
            Go<span class="text-amber-300">Discount</span> <span class="text-[10px] bg-amber-300 text-orange-950 px-2 py-0.5 rounded-full font-bold uppercase tracking-normal">B2C</span>
          </h1>
          <p class="text-xs font-bold text-amber-100 tracking-wider uppercase mt-0.5 flex items-center gap-1">
            <i class="fa-solid fa-bolt text-amber-300"></i> AHORROS Y OFERTAS INTELIGENTES
          </p>
        </div>
      </div>
      
      <div class="flex items-center space-x-3 text-xs">
        <div id="penalty-badge" class="hidden bg-red-600 text-white px-3 py-1.5 rounded-xl font-bold flex items-center gap-1.5 shadow-sm animate-pulse">
          <i class="fa-solid fa-ban"></i>
          <span>Penalización Activa (24h)</span>
        </div>
        <div class="bg-orange-700/60 border border-orange-400/40 px-3 py-1.5 rounded-xl flex items-center space-x-1.5">
          <i class="fa-solid fa-location-dot text-amber-300"></i>
          <span>Quito, Ecuador</span>
        </div>
      </div>
    </div>
    
    <!-- Navegación -->
    <nav class="flex bg-orange-700/80 text-xs sm:text-sm font-bold border-t border-orange-400/40 overflow-x-auto">
      <button onclick="switchTab('marketplace')" class="tab-btn active px-5 py-3 border-b-4 border-amber-300 flex items-center space-x-2 text-white bg-orange-800/40">
        <i class="fa-solid fa-bag-shopping"></i><span>Explorar Ofertas</span>
      </button>
      <button onclick="switchTab('publish')" class="tab-btn px-5 py-3 border-b-4 border-transparent hover:border-amber-300 text-orange-100 flex items-center space-x-2">
        <i class="fa-solid fa-store"></i><span>Panel Vendedor</span>
      </button>
      <button onclick="switchTab('reservations')" class="tab-btn px-5 py-3 border-b-4 border-transparent hover:border-amber-300 text-orange-100 flex items-center space-x-2 relative">
        <i class="fa-solid fa-clock-rotate-left"></i><span>Mis Reservas</span>
        <span id="active-res-count" class="hidden bg-amber-400 text-orange-950 font-black text-[10px] px-1.5 py-0.2 rounded-full">0</span>
      </button>
    </nav>
  </header>

  <main class="max-w-7xl mx-auto p-4 sm:p-6">

    <!-- 1. EXPLORAR OFERTAS -->
    <section id="tab-marketplace" class="tab-content active space-y-4">
      <!-- BARRA DE BÚSQUEDA Y FILTROS -->
      <div class="bg-white p-4 rounded-2xl shadow-sm border border-orange-100 space-y-3">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
          
          <!-- Búsqueda Texto -->
          <div class="md:col-span-1 flex items-center space-x-2 bg-amber-50/50 border border-amber-200 rounded-xl px-3 py-2">
            <i class="fa-solid fa-magnifying-glass text-orange-400"></i>
            <input type="text" id="search-text" oninput="renderMarketplace()" placeholder="Buscar producto, local o dirección..." class="bg-transparent w-full focus:outline-none text-xs font-medium">
          </div>

          <!-- Filtro Grupo/Categoría (11 Tipos) -->
          <div class="flex items-center space-x-1.5 bg-amber-50/50 border border-amber-200 rounded-xl px-2.5 py-2">
            <i class="fa-solid fa-layer-group text-orange-400 text-xs"></i>
            <select id="filter-group" onchange="renderMarketplace()" class="bg-transparent w-full focus:outline-none text-xs font-bold text-gray-700">
              <option value="">Todas las Categorías (11)</option>
              <option>Alimentos y bebidas</option>
              <option>Medicinas y salud</option>
              <option>Cuidado personal y aseo</option>
              <option>Hogar y limpieza</option>
              <option>Bebé y maternidad</option>
              <option>Mascotas</option>
              <option>Electrónica y tecnología</option>
              <option>Moda y accesorios</option>
              <option>Ferretería y herramientas</option>
              <option>Automotriz</option>
              <option>Servicios</option>
            </select>
          </div>

          <!-- Filtro Distancia -->
          <div class="flex items-center space-x-1.5 bg-amber-50/50 border border-amber-200 rounded-xl px-2.5 py-2">
            <i class="fa-solid fa-route text-orange-400 text-xs"></i>
            <select id="filter-distance" onchange="renderMarketplace()" class="bg-transparent w-full focus:outline-none text-xs font-bold text-gray-700">
              <option value="">Todas las Distancias</option>
              <option value="1">Hasta 1 Km</option>
              <option value="2">Hasta 2 Km</option>
              <option value="5">Hasta 5 Km</option>
            </select>
          </div>

          <!-- Filtro Porcentaje Descuento -->
          <div class="flex items-center space-x-1.5 bg-amber-50/50 border border-amber-200 rounded-xl px-2.5 py-2">
            <i class="fa-solid fa-percent text-orange-400 text-xs"></i>
            <select id="filter-discount" onchange="renderMarketplace()" class="bg-transparent w-full focus:outline-none text-xs font-bold text-gray-700">
              <option value="">Todos los Descuentos</option>
              <option value="30">30% o más</option>
              <option value="50">50% o más</option>
              <option value="70">70% o más</option>
            </select>
          </div>

        </div>
      </div>

      <div class="grid grid-cols-1 gap-6" id="offers-container"></div>
    </section>

    <!-- 2. PANEL VENDEDOR -->
    <section id="tab-publish" class="tab-content max-w-5xl mx-auto space-y-6">
      
      <!-- APARTADO 1: FORMULARIO DE REGISTRO DE OFERTAS SIN CAMPO DE DISTANCIA MANUAL -->
      <div class="bg-white rounded-2xl shadow-md p-6 border border-orange-100 space-y-4">
        <div class="border-b border-orange-100 pb-3 flex justify-between items-center">
          <div>
            <h2 class="text-xl font-black text-orange-600 flex items-center gap-2">
              <i class="fa-solid fa-plus-circle text-orange-500"></i> Formulario de Creación de Ofertas y Servicios
            </h2>
            <p class="text-sm text-gray-500">Configura los datos predeterminados de tu establecimiento y publica promociones.</p>
          </div>
        </div>

        <form onsubmit="event.preventDefault(); saveItemByVendor();" class="space-y-4 bg-orange-50/40 p-5 rounded-2xl border border-orange-200">
          
          <!-- Datos del Comercio (Predeterminados) -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-white p-3 rounded-xl border border-orange-200">
            <div>
              <label class="block text-xs font-bold text-orange-950 mb-1 flex items-center gap-1">
                <i class="fa-solid fa-store text-orange-500"></i> Nombre del Local / Comercio (Predeterminado)
              </label>
              <input type="text" id="v-store-name" value="Farmacia Medicity - Sucursal Jipijapa" required class="w-full border border-gray-300 rounded-xl p-2 text-xs font-bold text-gray-800 bg-amber-50/30 focus:ring-2 focus:ring-orange-400 focus:outline-none">
            </div>
            <div>
              <label class="block text-xs font-bold text-orange-950 mb-1 flex items-center gap-1">
                <i class="fa-solid fa-map-pin text-orange-500"></i> Dirección del Local (Predeterminada)
              </label>
              <input type="text" id="v-store-address" value="Av. 6 de Diciembre y Tomás de Berlanga" required class="w-full border border-gray-300 rounded-xl p-2 text-xs font-bold text-gray-800 bg-amber-50/30 focus:ring-2 focus:ring-orange-400 focus:outline-none">
            </div>
          </div>

          <!-- Datos del Producto u Oferta (Distancia eliminada) -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Categoría / Tipo (11 Opciones)</label>
              <select id="v-group" class="w-full border border-gray-300 rounded-xl p-2.5 text-sm bg-white font-medium focus:ring-2 focus:ring-orange-400 focus:outline-none">
                <option>Alimentos y bebidas</option>
                <option selected>Medicinas y salud</option>
                <option>Cuidado personal y aseo</option>
                <option>Hogar y limpieza</option>
                <option>Bebé y maternidad</option>
                <option>Mascotas</option>
                <option>Electrónica y tecnología</option>
                <option>Moda y accesorios</option>
                <option>Ferretería y herramientas</option>
                <option>Automotriz</option>
                <option>Servicios</option>
              </select>
            </div>
            <div class="md:col-span-2">
              <label class="block text-xs font-bold text-gray-700 mb-1">Producto o Servicio / Marca</label>
              <input type="text" id="v-desc" placeholder="Ej. Multivitamínico Complejo B 30 Tabs" required class="w-full border border-gray-300 rounded-xl p-2.5 text-sm bg-white focus:ring-2 focus:ring-orange-400 focus:outline-none">
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Fecha Limitada / Caducidad</label>
              <input type="date" id="v-expiry" required class="w-full border border-gray-300 rounded-xl p-2.5 text-sm bg-white focus:ring-2 focus:ring-orange-400 focus:outline-none">
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Cupos / Stock Disponibles</label>
              <input type="number" id="v-qty" min="1" value="10" required class="w-full border border-gray-300 rounded-xl p-2.5 text-sm bg-white focus:ring-2 focus:ring-orange-400 focus:outline-none">
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Precio Normal ($)</label>
              <input type="number" step="0.01" id="v-pvp" placeholder="12.00" required class="w-full border border-gray-300 rounded-xl p-2.5 text-sm bg-white font-bold focus:ring-2 focus:ring-orange-400 focus:outline-none">
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Descuento (%)</label>
              <input type="number" min="0" max="100" id="v-discount" value="40" required class="w-full border border-gray-300 rounded-xl p-2.5 text-sm bg-white font-bold text-orange-600 focus:ring-2 focus:ring-orange-400 focus:outline-none">
            </div>
          </div>
          <button type="submit" class="w-full bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white py-3 rounded-xl text-sm font-extrabold shadow-md transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-cloud-arrow-up"></i> Publicar Oferta en GoDiscount
          </button>
        </form>
      </div>

      <!-- APARTADO 2: MIS ÍTEMS ACTIVOS -->
      <div class="bg-white rounded-2xl shadow-md p-6 border border-orange-100 space-y-4">
        <div class="border-b border-orange-100 pb-3 flex justify-between items-center">
          <div>
            <h2 class="text-xl font-black text-gray-800 flex items-center gap-2">
              <i class="fa-solid fa-list-check text-orange-500"></i> Mis Ítems y Servicios Activos
            </h2>
            <p class="text-sm text-gray-500">Consulta y actualiza las promociones publicadas por tu establecimiento.</p>
          </div>
        </div>

        <div class="overflow-x-auto border border-gray-200 rounded-xl">
          <table class="w-full text-left text-xs">
            <thead class="bg-orange-50 border-b border-orange-100 font-bold text-gray-700">
              <tr>
                <th class="p-3">Local / Dirección</th>
                <th class="p-3">Producto/Servicio</th>
                <th class="p-3 text-center">Distancia Calc.</th>
                <th class="p-3 text-center">Caducidad</th>
                <th class="p-3 text-center">Disponible</th>
                <th class="p-3 text-center">Reservado</th>
                <th class="p-3 text-right">PVP Normal</th>
                <th class="p-3 text-center">Desc. %</th>
                <th class="p-3 text-center">Gestión</th>
              </tr>
            </thead>
            <tbody id="vendor-table-body"></tbody>
          </table>
        </div>
      </div>

      <!-- APARTADO 3: RESERVAS ACTIVAS DE CLIENTES -->
      <div class="bg-white rounded-2xl shadow-md p-6 border border-orange-100 space-y-4">
        <div class="border-b border-orange-100 pb-3 flex justify-between items-center">
          <div>
            <h2 class="text-xl font-black text-blue-900 flex items-center gap-2">
              <i class="fa-solid fa-users-viewfinder text-blue-600"></i> Reservas Activas de Clientes
            </h2>
            <p class="text-sm text-gray-500">Valida las entregas ingresando el PIN único del cliente comprador.</p>
          </div>
        </div>

        <div id="vendor-reservations-container" class="space-y-4">
          <!-- Renderizado dinámico -->
        </div>
      </div>

    </section>

    <!-- 3. VISTA CLIENTE: MIS RESERVAS -->
    <section id="tab-reservations" class="tab-content max-w-4xl mx-auto space-y-6">
      <div id="reservation-card" class="bg-white rounded-2xl shadow-md p-6 border border-orange-100 space-y-4">
        <!-- Renderizado dinámicamente -->
      </div>
    </section>

  </main>

  <script>
    // Inventario con la distancia calculada por la georreferenciación del sistema
    let inventory = [
      { 
        id: "ITEM-1", 
        storeName: "Farmacia Medicity - Sucursal Jipijapa", 
        storeAddress: "Av. 6 de Diciembre N34-120 y Tomás de Berlanga", 
        group: "Medicinas y salud", 
        desc: "Paracetamol 500mg (Genfar 20 Tabs)", 
        expiry: "2026-12-30", 
        distance: 0.5, 
        available: 15, 
        reserved: 0, 
        pvp: 3.00, 
        discount: 40 
      },
      { 
        id: "ITEM-2", 
        storeName: "Supermercado Supermaxi - Sucursal El Jardín", 
        storeAddress: "Av. República y Av. Amazonas (C.C. El Jardín)", 
        group: "Alimentos y bebidas", 
        desc: "Leche Entera 1L (Vita)", 
        expiry: "2026-09-25", 
        distance: 0.8, 
        available: 8, 
        reserved: 0, 
        pvp: 1.25, 
        discount: 50 
      },
      { 
        id: "ITEM-3", 
        storeName: "AutoServicios Kyu - Sucursal Norte", 
        storeAddress: "Av. de los Granados E12-40 y Eloy Alfaro", 
        group: "Servicios", 
        desc: "Mantenimiento / Alineación y Balanceo Vehicular", 
        expiry: "2026-11-15", 
        distance: 1.8, 
        available: 5, 
        reserved: 0, 
        pvp: 25.00, 
        discount: 70 
      },
      { 
        id: "ITEM-4", 
        storeName: "Distribuidora El Hogar - Sucursal Centro", 
        storeAddress: "Calle Guayaquil y Chile N5-22", 
        group: "Hogar y limpieza", 
        desc: "Detergente Líquido Multiusos 1L (Deja)", 
        expiry: "2027-01-10", 
        distance: 3.2, 
        available: 5, 
        reserved: 0, 
        pvp: 4.50, 
        discount: 30 
      },
      { 
        id: "ITEM-5", 
        storeName: "TechStore Ecuador - Sucursal Quicentro", 
        storeAddress: "Av. Naciones Unidas y Av. 6 de Diciembre", 
        group: "Electrónica y tecnología", 
        desc: "Audífonos Inalámbricos Bluetooth Pro", 
        expiry: "2026-10-30", 
        distance: 4.5, 
        available: 3, 
        reserved: 0, 
        pvp: 20.00, 
        discount: 50 
      }
    ];

    let currentBuyerName = "Santiago (Comprador)";
    let activeReservation = null;
    let penaltyUntil = null;
    let timerInterval = null;

    function generatePIN() {
      return Math.floor(100000 + Math.random() * 900000).toString();
    }

    function cleanInventory() {
      const today = new Date();
      inventory = inventory.filter(item => {
        const expDate = new Date(item.expiry);
        const diffTime = expDate - today;
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        
        const isExpired = diffDays <= 1;
        const isEmpty = (item.available === 0 && item.reserved === 0);
        return !isExpired && !isEmpty;
      });
    }

    function switchTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(el => {
        el.classList.remove('border-amber-300', 'text-white', 'bg-orange-800/40');
        el.classList.add('border-transparent', 'text-orange-100');
      });
      document.getElementById(`tab-${tabId}`).classList.add('active');
      event.currentTarget.classList.remove('border-transparent', 'text-orange-100');
      event.currentTarget.classList.add('border-amber-300', 'text-white', 'bg-orange-800/40');
      
      refreshAllViews();
    }

    function checkPenaltyStatus() {
      const penaltyBadge = document.getElementById('penalty-badge');
      if (penaltyUntil && new Date() < penaltyUntil) {
        penaltyBadge.classList.remove('hidden');
        return true;
      } else {
        penaltyUntil = null;
        penaltyBadge.classList.add('hidden');
        return false;
      }
    }

    function renderMarketplace() {
      cleanInventory();
      const container = document.getElementById('offers-container');
      
      const searchText = document.getElementById('search-text').value.toLowerCase();
      const groupFilter = document.getElementById('filter-group').value;
      const distanceFilter = parseFloat(document.getElementById('filter-distance').value);
      const discountFilter = parseInt(document.getElementById('filter-discount').value);

      const filtered = inventory.filter(i => {
        const matchesText = i.desc.toLowerCase().includes(searchText) || 
                            i.storeName.toLowerCase().includes(searchText) || 
                            i.storeAddress.toLowerCase().includes(searchText);
        const matchesGroup = !groupFilter || i.group === groupFilter;
        const matchesDistance = isNaN(distanceFilter) || i.distance <= distanceFilter;
        const matchesDiscount = isNaN(discountFilter) || i.discount >= discountFilter;
        
        return matchesText && matchesGroup && matchesDistance && matchesDiscount && i.available > 0;
      });

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="bg-white p-8 rounded-2xl text-center text-gray-500 font-bold border border-orange-100 space-y-2">
            <i class="fa-solid fa-filter-circle-xmark text-3xl text-orange-400"></i>
            <p>No se encontraron ofertas o servicios con los filtros aplicados.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = `
        <div class="bg-white rounded-2xl shadow-sm border border-orange-100 overflow-hidden p-5 space-y-4">
          <div class="flex justify-between items-center border-b border-orange-100 pb-3">
            <div>
              <h3 class="font-black text-gray-800 text-base flex items-center gap-2">
                <i class="fa-solid fa-store text-orange-500"></i> Ofertas y Servicios por Local Comercial
              </h3>
              <p class="text-xs text-gray-500 font-medium">Compara la ubicación exacta y las sucursales participantes</p>
            </div>
            <span class="bg-amber-100 text-orange-900 border border-amber-300 text-xs font-black px-3 py-1 rounded-full">Comercios Verificados</span>
          </div>

          <div class="overflow-x-auto border border-gray-100 rounded-xl">
            <table class="w-full text-left text-xs">
              <thead class="bg-gray-50 border-b border-gray-100 text-gray-600 font-bold">
                <tr>
                  <th class="p-3">Local Comercial (Vendedor) y Dirección</th>
                  <th class="p-3">Producto / Servicio</th>
                  <th class="p-3 text-center">Distancia Calc.</th>
                  <th class="p-3 text-center">Caducidad/Validez</th>
                  <th class="p-3 text-center">Disponible</th>
                  <th class="p-3 text-center">Reservado</th>
                  <th class="p-3 text-right">PVP Normal</th>
                  <th class="p-3 text-center">Desc. Ítem</th>
                  <th class="p-3 text-right">Precio GoDiscount</th>
                  <th class="p-3 text-center">Acción</th>
                </tr>
              </thead>
              <tbody>
                ${filtered.map(item => {
                  const itemPrice = item.pvp * (1 - item.discount / 100);
                  return `
                    <tr class="border-b border-gray-50 hover:bg-amber-50/20 transition">
                      <td class="p-3">
                        <div class="font-extrabold text-gray-900 flex items-center gap-1.5">
                          <i class="fa-solid fa-shop text-orange-500"></i> ${item.storeName}
                        </div>
                        <div class="text-[11px] text-gray-500 flex items-center gap-1 mt-0.5">
                          <i class="fa-solid fa-location-dot text-red-400"></i> ${item.storeAddress}
                        </div>
                      </td>
                      <td class="p-3">
                        <span class="text-[10px] bg-orange-50 text-orange-600 font-bold px-1.5 py-0.5 rounded block w-max mb-1">${item.group}</span>
                        <strong class="text-gray-800">${item.desc}</strong>
                      </td>
                      <td class="p-3 text-center font-bold text-gray-600">
                        <i class="fa-solid fa-route text-orange-500 mr-1"></i>${item.distance} Km
                      </td>
                      <td class="p-3 text-center font-bold text-red-500">${item.expiry}</td>
                      <td class="p-3 text-center font-black text-emerald-600">${item.available} u.</td>
                      <td class="p-3 text-center font-bold text-amber-600">${item.reserved} u.</td> <td class="p-3 text-right text-gray-400 line-through">$${item.pvp.toFixed(2)}</td>
                      <td class="p-3 text-center"><span class="bg-amber-100 text-orange-800 font-black px-2 py-0.5 rounded border border-amber-300">-${item.discount}\%</span></td> <td class="p-3 text-right font-black text-orange-600">$${itemPrice.toFixed(2)}</td>
                      <td class="p-3 text-center">
                        <button onclick="createOrAddToReservation('${item.id}')" class="bg-orange-500 hover:bg-orange-600 text-white font-extrabold px-3 py-1.5 rounded-lg shadow-sm transition flex items-center gap-1 mx-auto">
                          <i class="fa-solid fa-cart-plus"></i> Reservar
                        </button>
                      </td>
                    </tr>
                  `;
                }).join('')}
              </tbody>
            </table>
          </div>
        </div>
      `;
    }

    function createOrAddToReservation(itemId) {
      if (checkPenaltyStatus()) {
        alert("⚠️ Tienes una penalización activa de 24 horas por una reserva no completada o cancelada.");
        return;
      }

      const item = inventory.find(i => i.id === itemId);
      if (!item || item.available <= 0) {
        alert("No hay inventario o cupos disponibles.");
        return;
      }

      if (!activeReservation) {
        const expireTime = new Date(Date.now() + 2 * 60 * 60 * 1000);
        activeReservation = {
          id: `RES-${Math.floor(1000 + Math.random() * 9000)}`,
          buyerName: currentBuyerName,
          pin: generatePIN(),
          items: [],
          expiresAt: expireTime
        };
        startTimer();
      }

      const existingInRes = activeReservation.items.find(i => i.itemId === itemId);
      if (existingInRes) {
        existingInRes.qty += 1;
      } else {
        activeReservation.items.push({ itemId: itemId, qty: 1 });
      }

      item.available -= 1;
      item.reserved += 1;

      refreshAllViews();
      alert(`✅ Reserva realizada en ${item.storeName}. Tu PIN es: ${activeReservation.pin}. Presenta este PIN en el local.`);
    }

    function startTimer() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        if (!activeReservation) {
          clearInterval(timerInterval);
          return;
        }

        const now = new Date();
        const diff = activeReservation.expiresAt - now;

        if (diff <= 0) {
          clearInterval(timerInterval);
          expireReservation(true);
        } else {
          renderReservationTab();
          renderVendorReservations();
        }
      }, 1000);
    }

    function expireReservation(applyPenalty = true) {
      if (!activeReservation) return;

      activeReservation.items.forEach(resItem => {
        const item = inventory.find(i => i.id === resItem.itemId);
        if (item) {
          item.available += resItem.qty;
          item.reserved -= resItem.qty;
        }
      });

      activeReservation = null;
      if (timerInterval) clearInterval(timerInterval);

      if (applyPenalty) {
        penaltyUntil = new Date(Date.now() + 24 * 60 * 60 * 1000);
        alert("🚨 Tu reserva expiró sin ser validada por el comercio. Se ha aplicado una penalización de 24 horas.");
      }

      refreshAllViews();
    }

    function updateReservationQty(itemId, change) {
      if (!activeReservation) return;

      const resItem = activeReservation.items.find(i => i.itemId === itemId);
      const item = inventory.find(i => i.id === itemId);
      if (!resItem || !item) return;

      if (change > 0) {
        if (item.available <= 0) {
          alert("No hay más stock disponible para aumentar.");
          return;
        }
        resItem.qty += 1;
        item.available -= 1;
        item.reserved += 1;
      } else if (change < 0) {
        const totalUnits = activeReservation.items.reduce((acc, i) => acc + i.qty, 0);
        if (totalUnits <= 1 && resItem.qty <= 1) {
          alert("⚠️ Debes mantener al menos 1 unidad en tu reserva.");
          return;
        }

        resItem.qty -= 1;
        item.available += 1;
        item.reserved -= 1;

        if (resItem.qty === 0) {
          activeReservation.items = activeReservation.items.filter(i => i.itemId !== itemId);
        }
      }

      refreshAllViews();
    }

    function reportDefectiveItem(itemId) {
      if (!activeReservation) return;

      const confirmReport = confirm("¿Deseas reportar este producto/servicio por problemas de disponibilidad o estado?");
      if (!confirmReport) return;

      const resItem = activeReservation.items.find(i => i.itemId === itemId);
      const item = inventory.find(i => i.id === itemId);

      if (resItem && item) {
        item.available += resItem.qty;
        item.reserved -= resItem.qty;
        
        activeReservation.items = activeReservation.items.filter(i => i.itemId !== itemId);
        alert("✅ Reporte registrado. Ítem removido.");

        if (activeReservation.items.length === 0) {
          activeReservation = null;
          if (timerInterval) clearInterval(timerInterval);
        }

        refreshAllViews();
      }
    }

    function validateSaleWithPIN(providedPin) {
      if (!activeReservation) return;

      if (!providedPin) {
        alert("Por favor ingresa el Código PIN de 6 dígitos.");
        return;
      }

      if (providedPin.trim() === activeReservation.pin) {
        activeReservation.items.forEach(resItem => {
          const item = inventory.find(i => i.id === resItem.itemId);
          if (item) {
            item.reserved -= resItem.qty;
          }
        });

        activeReservation = null;
        if (timerInterval) clearInterval(timerInterval);

        alert("🎉 ¡PIN Correcto! Transacción completada con éxito.");
        refreshAllViews();
      } else {
        alert("❌ Código PIN incorrecto.");
      }
    }

    function copyPinToClipboard() {
      if (!activeReservation) return;
      navigator.clipboard.writeText(activeReservation.pin);
      alert(`PIN ${activeReservation.pin} copiado al portapapeles.`);
    }

    function renderReservationTab() {
      const card = document.getElementById('reservation-card');
      const countBadge = document.getElementById('active-res-count');

      if (!activeReservation || activeReservation.items.length === 0) {
        countBadge.classList.add('hidden');
        card.innerHTML = `
          <div class="text-center py-8 space-y-3">
            <i class="fa-solid fa-clock-rotate-left text-4xl text-gray-300"></i>
            <p class="text-sm font-bold text-gray-500">No tienes ninguna reserva activa en este momento.</p>
          </div>
        `;
        return;
      }

      countBadge.innerText = activeReservation.items.length;
      countBadge.classList.remove('hidden');

      const now = new Date();
      const diffMs = activeReservation.expiresAt - now;
      const minutes = Math.floor(diffMs / 60000);
      const seconds = Math.floor((diffMs % 60000) / 1000);

      let totalPvp = 0;
      let totalFinal = 0;

      const itemsHtml = activeReservation.items.map(resItem => {
        const item = inventory.find(i => i.id === resItem.itemId);
        if (!item) return '';

        const itemFinalPrice = item.pvp * (1 - item.discount / 100);
        const subtotal = itemFinalPrice * resItem.qty;
        totalPvp += item.pvp * resItem.qty;
        totalFinal += subtotal;

        return `
          <tr class="border-b text-xs">
            <td class="p-2.5">
              <div class="font-extrabold text-orange-600">${item.storeName}</div>
              <div class="text-[10px] text-gray-500">${item.storeAddress}</div>
              <strong class="text-gray-800 block mt-1">${item.desc}</strong>
            </td>
            <td class="p-2 text-center text-gray-400 line-through">$${item.pvp.toFixed(2)}</td>
            <td class="p-2 text-center font-bold text-orange-600">-${item.discount}%</td>
            <td class="p-2 text-center">
              <div class="flex items-center justify-center space-x-2">
                <button onclick="updateReservationQty('${item.id}', -1)" class="w-6 h-6 bg-gray-200 rounded-md font-black hover:bg-gray-300">-</button>
                <span class="font-extrabold">${resItem.qty}</span>
                <button onclick="updateReservationQty('${item.id}', 1)" class="w-6 h-6 bg-gray-200 rounded-md font-black hover:bg-gray-300">+</button>
              </div>
            </td>
            <td class="p-2 text-right font-black text-gray-800">$${subtotal.toFixed(2)}</td>
            <td class="p-2 text-center">
              <button onclick="reportDefectiveItem('${item.id}')" class="text-red-500 hover:text-red-700 font-bold flex items-center gap-1 justify-center" title="Reportar mal estado">
                <i class="fa-solid fa-triangle-exclamation"></i> Reportar
              </button>
            </td>
          </tr>
        `;
      }).join('');

      card.innerHTML = `
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b border-gray-100 pb-3 gap-2">
          <div>
            <h2 class="text-lg font-black text-gray-800 flex items-center gap-2">
              <i class="fa-solid fa-receipt text-orange-500"></i> Reserva Activa
            </h2>
            <p class="text-xs text-gray-500">Comprador: <strong>${activeReservation.buyerName}</strong></p>
          </div>
          <div class="bg-amber-100 border border-amber-300 text-orange-950 font-black px-4 py-2 rounded-xl text-sm flex items-center gap-2">
            <i class="fa-solid fa-hourglass-half text-orange-600 animate-spin"></i>
            <span>Tiempo: ${minutes}:${seconds < 10 ? '0' : ''}${seconds} min</span>
          </div>
        </div>

        <div class="bg-gradient-to-r from-slate-900 to-slate-800 text-white p-4 rounded-2xl flex flex-col sm:flex-row justify-between items-center gap-4 shadow-lg border border-slate-700">
          <div class="space-y-1 text-center sm:text-left">
            <span class="text-[10px] font-bold uppercase tracking-widest text-amber-400">Código de Confirmación para Validar Venta</span>
            <div class="text-3xl font-black tracking-widest text-white flex items-center gap-3">
              <span>PIN: ${activeReservation.pin}</span>
              <button onclick="copyPinToClipboard()" class="text-xs bg-white/10 hover:bg-white/20 p-2 rounded-lg transition" title="Copiar PIN">
                <i class="fa-regular fa-copy"></i>
              </button>
            </div>
            <p class="text-xs text-slate-300">Muestra este código al vendedor para completar la compra en la sucursal.</p>
          </div>
          <div class="bg-white/10 p-3 rounded-xl border border-white/10 text-center">
            <i class="fa-solid fa-key text-amber-300 text-2xl"></i>
            <p class="text-[10px] text-amber-200 mt-1 font-bold">PIN ÚNICO</p>
          </div>
        </div>

        <div class="overflow-x-auto border border-gray-100 rounded-xl">
          <table class="w-full text-left text-xs">
            <thead class="bg-orange-50 border-b border-orange-100 text-orange-950 font-bold">
              <tr>
                <th class="p-2.5">Local y Producto</th>
                <th class="p-2 text-center">PVP Orig.</th>
                <th class="p-2 text-center">Desc. Ítem</th>
                <th class="p-2 text-center">Cantidad</th>
                <th class="p-2 text-right">Subtotal</th>
                <th class="p-2 text-center">Incidencia</th>
              </tr>
            </thead>
            <tbody>
              ${itemsHtml}
            </tbody>
          </table>
        </div>

        <div class="bg-orange-50/70 p-4 rounded-2xl border border-orange-200 space-y-3">
          <div class="flex flex-col sm:flex-row justify-between items-center gap-2">
            <div class="text-xs space-y-0.5">
              <p class="text-gray-500">Total PVP Original: <strong class="line-through">$${totalPvp.toFixed(2)}</strong></p>
              <p class="text-base font-black text-orange-600">TOTAL A PAGAR EN LOCAL: $${totalFinal.toFixed(2)}</p>
            </div>
          </div>
        </div>
      `;
    }

    function saveItemByVendor() {
      const storeName = document.getElementById('v-store-name').value;
      const storeAddress = document.getElementById('v-store-address').value;
      const group = document.getElementById('v-group').value;
      const desc = document.getElementById('v-desc').value;
      const expiry = document.getElementById('v-expiry').value;
      const qty = parseInt(document.getElementById('v-qty').value);
      const pvp = parseFloat(document.getElementById('v-pvp').value);
      const discount = parseInt(document.getElementById('v-discount').value);

      // Distancia calculada automáticamente por el sistema (ej. 0.5 km)
      const calculatedDistance = 0.5;

      const newItem = {
        id: `ITEM-${Date.now()}`,
        storeName,
        storeAddress,
        group, 
        desc, 
        distance: calculatedDistance, 
        expiry, 
        available: qty, 
        reserved: 0, 
        pvp, 
        discount
      };

      inventory.unshift(newItem);
      alert(`✅ Oferta para "${storeName}" publicada correctamente.`);
      refreshAllViews();
    }

    function renderVendorTable() {
      cleanInventory();
      const tbody = document.getElementById('vendor-table-body');
      
      tbody.innerHTML = inventory.map(item => `
        <tr class="border-b text-xs">
          <td class="p-3">
            <strong class="text-orange-600 block">${item.storeName}</strong>
            <span class="text-[10px] text-gray-500">${item.storeAddress}</span>
          </td>
          <td class="p-3">
            <span class="text-[10px] bg-orange-100 text-orange-800 font-bold px-1.5 py-0.5 rounded block w-max mb-0.5">${item.group}</span>
            <strong class="text-gray-800">${item.desc}</strong>
          </td>
          <td class="p-3 text-center font-bold text-gray-600">${item.distance} Km</td>
          <td class="p-3 text-center text-red-500 font-bold">${item.expiry}</td>
          <td class="p-3 text-center font-bold text-emerald-600">${item.available} u.</td>
          <td class="p-3 text-center font-bold text-amber-600">${item.reserved} u.</td>
          <td class="p-3 text-right font-medium">$${item.pvp.toFixed(2)}</td>
          <td class="p-3 text-center"><span class="bg-amber-100 text-orange-800 font-bold px-2 py-0.5 rounded">-${item.discount}%</span></td>
          <td class="p-3 text-center">
            <button onclick="updateVendorItemPrompt('${item.id}')" class="bg-orange-100 text-orange-700 px-2.5 py-1 rounded-lg font-bold hover:bg-orange-200 transition">
              <i class="fa-solid fa-pen-to-square"></i> Editar
            </button>
          </td>
        </tr>
      `).join('');
    }

    function renderVendorReservations() {
      const container = document.getElementById('vendor-reservations-container');

      if (!activeReservation || activeReservation.items.length === 0) {
        container.innerHTML = `
          <div class="text-center py-6 text-gray-400 font-medium text-xs bg-gray-50 rounded-xl border border-dashed border-gray-200">
            <i class="fa-solid fa-inbox text-2xl mb-1 text-gray-300 block"></i>
            No hay reservas pendientes registradas en este momento.
          </div>
        `;
        return;
      }

      const now = new Date();
      const diffMs = activeReservation.expiresAt - now;
      const minutes = Math.floor(diffMs / 60000);
      const seconds = Math.floor((diffMs % 60000) / 1000);

      let totalFinal = 0;
      const itemsList = activeReservation.items.map(resItem => {
        const item = inventory.find(i => i.id === resItem.itemId);
        if (!item) return '';
        const itemPrice = item.pvp * (1 - item.discount / 100);
        const sub = itemPrice * resItem.qty;
        totalFinal += sub;
        return `
          <div class="flex justify-between items-center text-xs border-b border-gray-100 pb-1">
            <span class="font-medium text-gray-700">${resItem.qty}x ${item.desc} (${item.storeName})</span>
            <span class="font-bold text-gray-900">$${sub.toFixed(2)}</span>
          </div>
        `;
      }).join('');

      container.innerHTML = `
        <div class="bg-blue-50/40 border border-blue-200 rounded-2xl p-5 space-y-4">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b border-blue-100 pb-3">
            <div>
              <div class="flex items-center gap-2">
                <span class="bg-blue-600 text-white font-black text-[10px] px-2 py-0.5 rounded-full uppercase">${activeReservation.id}</span>
                <h3 class="font-black text-gray-800 text-base flex items-center gap-1.5">
                  <i class="fa-solid fa-user-tag text-blue-600"></i> ${activeReservation.buyerName}
                </h3>
              </div>
              <p class="text-xs text-gray-500 mt-0.5">Comprador registrado en GoDiscount</p>
            </div>
            
            <div class="bg-amber-100 border border-amber-300 text-orange-950 font-bold px-3 py-1 rounded-xl text-xs flex items-center gap-1.5">
              <i class="fa-solid fa-clock text-orange-600"></i>
              <span>Expiración en: ${minutes}:${seconds < 10 ? '0' : ''}${seconds} min</span>
            </div>
          </div>

          <div class="space-y-2 bg-white p-3 rounded-xl border border-blue-100">
            <p class="text-[11px] font-bold text-gray-500 uppercase tracking-wider">Detalle de Productos/Servicios Reservados:</p>
            ${itemsList}
            <div class="pt-2 flex justify-between items-center border-t border-gray-100">
              <span class="text-xs font-black text-gray-700">Monto Total a Cobrar al Cliente:</span>
              <span class="text-base font-black text-blue-900">$${totalFinal.toFixed(2)}</span>
            </div>
          </div>

          <div class="bg-white p-4 rounded-xl border border-blue-200 flex flex-col sm:flex-row gap-3 items-center">
            <div class="flex-1 w-full">
              <label class="block text-[11px] font-bold text-gray-700 mb-1">Ingrese el PIN del comprador para validar:</label>
              <input type="text" id="v-pin-field" placeholder="Ej. 654321" class="w-full border border-gray-300 rounded-xl px-3 py-2 text-sm font-bold text-center tracking-widest focus:ring-2 focus:ring-blue-500 focus:outline-none">
            </div>
            <button onclick="validateSaleWithPIN(document.getElementById('v-pin-field').value)" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-extrabold px-5 py-2.5 rounded-xl text-xs shadow-md transition flex items-center justify-center gap-2 self-end">
              <i class="fa-solid fa-check-circle"></i> Validar Venta por PIN
            </button>
          </div>
        </div>
      `;
    }

    function updateVendorItemPrompt(itemId) {
      const item = inventory.find(i => i.id === itemId);
      if (!item) return;

      const newQty = prompt("Nuevo stock/cupos disponible:", item.available);
      const newDisc = prompt("Nuevo Porcentaje de descuento (%):", item.discount);

      if (newQty !== null) item.available = parseInt(newQty) || 0;
      if (newDisc !== null) item.discount = parseInt(newDisc) || 0;

      refreshAllViews();
    }

    function refreshAllViews() {
      checkPenaltyStatus();
      renderMarketplace();
      renderVendorTable();
      renderVendorReservations();
      renderReservationTab();
    }

    // Inicialización
    refreshAllViews();
  </script>
</body>
</html>
